# ============================================================
# Market Intelligence AI — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME="Market Intelligence AI"
APP_ENV=development                    # development | staging | production
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
ALLOWED_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL + pgvector) ────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=market_intelligence
POSTGRES_USER=mi_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://mi_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/market_intelligence
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Cache / Queue (Redis) ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── MLflow ──────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=market-intelligence-ai

# ── Market Data Providers ────────────────────────────────────
# Live market data must come from a broker/API such as Kite Connect.
# Yahoo Finance is for historical/backtesting data only.
LIVE_MARKET_DATA_PROVIDER=zerodha
HISTORICAL_MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_PROVIDER=yfinance
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=

# NSE / BSE specific
NSE_API_BASE_URL=https://www.nseindia.com
BSE_API_BASE_URL=https://api.bseindia.com

# ── News / Information Providers ────────────────────────────
NEWS_PROVIDER=gnews                    # gnews | newsapi | rss_aggregator
GNEWS_API_KEY=
NEWSAPI_KEY=
EODHD_API_KEY=

# ── LLM Provider ────────────────────────────────────────────
# Provider: "openai" | "anthropic" | "google" | "local_ollama"
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
GOOGLE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Broker Integration ───────────────────────────────────────
# !! LIVE TRADING IS DISABLED BY DEFAULT !!
# Do NOT set LIVE_TRADING_ENABLED=true until all safety gates pass.
LIVE_TRADING_ENABLED=false

# Paper trading broker settings (virtual)
PAPER_TRADING_INITIAL_CAPITAL=50000.0       # ₹50,000 virtual capital
PAPER_TRADING_CURRENCY=INR

# Live broker (Zerodha Kite — only used if LIVE_TRADING_ENABLED=true)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_USER_ID=
ZERODHA_REDIRECT_URL=http://localhost:8000/broker/callback

# Upstox (alternative live broker)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ANALYTICS_TOKEN=

# ── Risk Limits (HARD LIMITS — AI CANNOT OVERRIDE) ──────────
MAX_PORTFOLIO_RISK_PCT=2.0             # Max % of portfolio per single trade
MAX_POSITION_SIZE_PCT=10.0             # Max % of portfolio in any one stock
MAX_SECTOR_EXPOSURE_PCT=30.0           # Max % portfolio in any one sector
MAX_DAILY_LOSS_PCT=5.0                 # Daily loss circuit breaker
MAX_DRAWDOWN_PCT=20.0                  # Maximum portfolio drawdown
MAX_ORDERS_PER_MINUTE=10              # Abnormal order frequency trigger
MIN_SIGNAL_CONFIDENCE=60              # Min confidence score to consider trade
MAX_CORRELATION_NEW_POSITION=0.7      # Max allowed correlation with existing

# ── Emergency Kill Switch ────────────────────────────────────
EMERGENCY_KILL_SWITCH_ACTIVE=false    # Set true to halt ALL activity immediately
EMERGENCY_KILL_REQUIRES_MANUAL_RESET=true

# ── Notifications ────────────────────────────────────────────
# Email
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@market-intelligence.local
ALERT_EMAIL_TO=

# Webhook (Slack, Discord, etc.)
NOTIFICATION_WEBHOOK_ENABLED=false
WEBHOOK_URL=

# ── Data Quality ─────────────────────────────────────────────
MAX_PRICE_STALENESS_SECONDS=60        # Reject prices older than this
MAX_NEWS_STALENESS_HOURS=24
DATA_QUALITY_MIN_COMPLETENESS=0.8     # Min fraction of required fields

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                        # json | text
LOG_FILE_PATH=/var/log/market-intelligence/app.log
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=/var/log/market-intelligence/audit.log

# ── Security ─────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_LONG_RANDOM
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ── Rate Limiting ─────────────────────────────────────────────
API_RATE_LIMIT_PER_MINUTE=60
NEWS_FETCH_INTERVAL_SECONDS=300       # How often to poll news sources
PRICE_FETCH_INTERVAL_SECONDS=60       # How often to update prices

# ── Backtesting ──────────────────────────────────────────────
BACKTEST_DEFAULT_COMMISSION_PCT=0.03   # 0.03% commission
BACKTEST_DEFAULT_SLIPPAGE_PCT=0.05     # 0.05% slippage
BACKTEST_DEFAULT_INITIAL_CAPITAL=1000000.0

# ── Feature Flags ────────────────────────────────────────────
FEATURE_KNOWLEDGE_GRAPH=true
FEATURE_LLM_THESIS=true
FEATURE_TECHNICAL_ANALYSIS=true
FEATURE_FUNDAMENTAL_ANALYSIS=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_BACKTESTING=true
FEATURE_PAPER_TRADING=true
